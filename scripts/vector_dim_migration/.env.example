# Environment variables for re-embedding script
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git (should be in .gitignore)

# Required: Supabase credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key-here

# Optional: Embedding provider (default: google)
# Supported values: google, ollama
LLM_PROVIDER=google

# Required if LLM_PROVIDER=google
GOOGLE_API_KEY=your-google-api-key-here

# Optional: Ollama base URL (default: http://localhost:11434)
# Only needed if LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
