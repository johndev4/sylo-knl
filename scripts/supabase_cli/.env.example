# Environment variables for supabase scripts
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git (should be in .gitignore)

# Required: Supabase API Token
SUPABASE_API_TOKEN=your-supabase-api-token

# Required: Supabase Project Reference ID
SUPABASE_PROJECT_REF_ID=your-project-ref
