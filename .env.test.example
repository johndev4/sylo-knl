# Environment variables for testing. These will be loaded by Playwright when running tests.
# See Playwright documentation for more details: https://playwright.dev/docs/test-configuration#

# Playwright test user credentials (these should match a test user in your Supabase instance)
PLAYWRIGHT_TEST_EMAIL="your-test-email@example.com"
PLAYWRIGHT_TEST_PASSWORD="your-test-password"

# Supabase service role key (secret, do NOT expose in client-side code)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
