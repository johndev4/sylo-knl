# ==============================================================================
# ENVIRONMENT VARIABLES FOR TESTING (.env.test.example)
#
# Instructions:
# 1. Copy this file and rename it to `.env.test`
# 2. Replace the placeholder values with your real test credentials.
#
# For details, see Playwright docs:
# https://playwright.dev/docs/test-configuration#
# ==============================================================================

# ------------------------------------------------------------------------------
# Primary Test User
# Credentials for the main test user account in your Supabase database.
# Used for tests requiring an authenticated user.
# ------------------------------------------------------------------------------
PLAYWRIGHT_TEST_EMAIL="user1@example.com"
PLAYWRIGHT_TEST_PASSWORD="your-test-user-1-password"

# ------------------------------------------------------------------------------
# Secondary Test User
# Credentials for a second test user account in your Supabase database.
# Used for testing interactions between two users (e.g., chat, sharing, permissions).
# ------------------------------------------------------------------------------
PLAYWRIGHT_2ND_TEST_EMAIL="user2@example.com"
PLAYWRIGHT_2ND_TEST_PASSWORD="your-test-user-2-password"

# ------------------------------------------------------------------------------
# Supabase Admin / Service Role Key
# SECRET: Access key with full database rights to bypass RLS (Row Level Security).
# Used by test setup scripts to clean up or seed test data directly.
# WARNING: Keep this private. Never leak this key in client-side code!
# ------------------------------------------------------------------------------
SUPABASE_SECRET_KEY="your-supabase-service-role-key-here"