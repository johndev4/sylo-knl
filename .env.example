# Environment variables for Knowledge Library RAG Application

# ============================================================================
# Database Configuration
# ============================================================================

# Prisma supports the native connection string format for PostgreSQL, MySQL, 
# SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Primary database connection (with pooling for serverless compatibility)
DATABASE_URL="postgresql://user:password@host:5432/database?pgbouncer=true"

# Direct connection to the database (used for migrations)
DIRECT_URL="postgresql://user:password@host:5432/database"

# ============================================================================
# Supabase Configuration (Authentication & Storage)
# ============================================================================

# Supabase project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Supabase anonymous key (public, safe to expose)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ============================================================================
# LLM Provider Configuration
# ============================================================================

# Active LLM provider: 'google' or 'ollama'
# Default: 'google' (uses Google Generative AI)
# Set to 'ollama' to use local Ollama instances
LLM_PROVIDER=google

# ============================================================================
# Google Generative AI Configuration
# ============================================================================

# Google API key for Gemini models (required if LLM_PROVIDER=google)
# Get your key from: https://makersuite.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY="your-google-api-key"

# ============================================================================
# Embedding Provider Configuration
# ============================================================================

# Active embedding provider: 'google' or 'ollama'
# Default: falls back to LLM_PROVIDER if not specified
# Set to 'ollama' to use local Ollama embeddings
EMBEDDING_PROVIDER=google

# ============================================================================
# Ollama Configuration (Local LLM & Embeddings)
# ============================================================================

# Base URL for local Ollama instance
# Default: http://localhost:11434
# For remote Ollama: http://192.168.x.x:11434
OLLAMA_BASE_URL=http://localhost:11434/api

# Ollama LLM model name
# Examples: mistral, llama2, neural-chat
# Default: mistral
OLLAMA_LLM_MODEL=mistral:latest

# Ollama embedding model name
# Examples: nomic-embed-text, all-minilm-l6-v2
# Default: nomic-embed-text
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# Ollama embedding model dimension
# Default: 1536 (common for most models)
# Adjust based on your embedding model
# OLLAMA_EMBEDDING_DIMENSION=1536
