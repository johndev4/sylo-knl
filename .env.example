# ==============================================================================
# ENVIRONMENT VARIABLES SETUP (.env.example)
#
# Instructions:
# 1. Copy this file and rename it to `.env.local` for local development.
# 2. Fill in the required values below.
# ==============================================================================


# ------------------------------------------------------------------------------
# App URL
# ------------------------------------------------------------------------------
# Base URL for the application.
# Default: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Get these credentials from your Supabase Dashboard: Project Settings -> API

# Public project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Public API key (Safe for browser/client-side code)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Secret service role key (Server-side ONLY - Never expose to client!)
SUPABASE_SECRET_KEY="your-secret-key"


# ------------------------------------------------------------------------------
# AI Provider Settings
# ------------------------------------------------------------------------------

# Active LLM provider
# Options: 'google' | 'ollama'
# Default: 'google'
LLM_PROVIDER="google"

# Active embedding provider
# Options: 'google' | 'ollama'
# Default: Uses LLM_PROVIDER setting
EMBEDDING_PROVIDER="google"


# ------------------------------------------------------------------------------
# Google AI Configuration
# Required if LLM_PROVIDER or EMBEDDING_PROVIDER is set to 'google'
# Get API Key: https://makersuite.google.com/app/apikey
# ------------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY="your-google-api-key"
# Optional: Model overrides
# GOOGLE_LLM_MODEL="gemini-3.8-flash"
# GOOGLE_EMBEDDING_MODEL="gemini-embedding-001"


# ------------------------------------------------------------------------------
# Ollama Configuration (Local AI)
# Required if LLM_PROVIDER or EMBEDDING_PROVIDER is set to 'ollama'
# ------------------------------------------------------------------------------

# Base URL for your Ollama API instance
# Local default: http://localhost:11434/api
# Remote example: http://192.168.1.100:11434/api
OLLAMA_BASE_URL="http://localhost:11434/api"

# Model used for text generation (e.g., gemma4:e4b, llama2, neural-chat)
OLLAMA_LLM_MODEL="gemma4:e4b"

# Model used for embeddings (e.g., nomic-embed-text:v1.5, all-minilm-l6-v2)
OLLAMA_EMBEDDING_MODEL="nomic-embed-text:v1.5"

# ------------------------------------------------------------------------------
# Local Authentication Credentials
# Used ONLY for local Supabase OAuth testing
# ------------------------------------------------------------------------------
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID="your-google-client-id"
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET="your-google-client-secret-key"


# ------------------------------------------------------------------------------
# Supabase Management API Configuration
# Used for programmatic access to Supabase Management API and Supabase CLI
# ------------------------------------------------------------------------------
# Personal access token for Supabase Management API
# Get from: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
# Project reference ID from your Supabase project
# Found in: Project Settings -> General -> Reference ID
SUPABASE_PROJECT_REF_ID=your-project-ref


# ------------------------------------------------------------------------------
# Cron Worker Secret
# A random secret used to authenticate the /api/embed-pending internal endpoint.
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------------------------
CRON_SECRET="your-cron-secret"
